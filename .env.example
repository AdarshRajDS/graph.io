# Local development defaults only. Copy to .env and never commit .env.
# These values are not production secrets.
# Host ports 3100/8100 avoid common clashes with other Node and FastAPI apps.

POSTGRES_USER=mathvis
POSTGRES_PASSWORD=mathvis_dev
POSTGRES_DB=mathvis
POSTGRES_PORT=5432

REDIS_PORT=6379

API_HOST=0.0.0.0
API_PORT=8000
API_HOST_PORT=8100
DATABASE_URL=postgresql+psycopg://mathvis:mathvis_dev@postgres:5432/mathvis
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3100

WEB_PORT=3100
NEXT_PUBLIC_API_URL=http://localhost:8100
API_INTERNAL_URL=http://api:8000

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

S3_ACCESS_KEY=mathvis_minio
S3_SECRET_KEY=mathvis_minio_dev
S3_BUCKET=math-vis
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
